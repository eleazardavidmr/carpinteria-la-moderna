---
import Icono from './Icono.astro';
import { links, negocio } from '../data/negocio';
---
<section id="contacto" class="marco bg-tinta text-papel" aria-labelledby="contacto-titulo">
  <div class="contenedor pt-16 text-center sm:pt-20 lg:pt-24" data-reveal>
    <p class="text-[0.8125rem] font-medium text-gris-claro">Contacto y ubicación</p>
    <h2 id="contacto-titulo" class="titulo-l mx-auto mt-3 max-w-[16ch]">Conozca nuestro taller</h2>
    <p class="mx-auto mt-4 max-w-md text-[1.05rem] text-papel/80">
      {negocio.direccion}, {negocio.sector}, {negocio.ciudad}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-2.5">
      <a href={`mailto:${negocio.correo}`} class="btn bg-papel text-tinta hover:bg-niebla">
        <Icono nombre="enviar" class="size-5" />
        Escribir un correo
      </a>
      <a href={links.whatsapp} target="_blank" rel="noopener" class="btn btn-borde-claro">
        <Icono nombre="whatsapp" class="size-5" />
        Escribir por WhatsApp
      </a>
    </div>
    <p class="mx-auto mt-4 max-w-sm text-[0.85rem] leading-relaxed text-gris-claro">
      Use WhatsApp para consultas rápidas. Si quiere cotizar, llene el{' '}
      <a href="#cotizar" class="font-medium text-papel underline decoration-ambar decoration-2 underline-offset-4">formulario de solicitud</a>: así recibimos todos los detalles.
    </p>

    <dl class="mx-auto mt-8 flex max-w-2xl flex-wrap justify-center gap-2 text-left">
      <div class="chip bg-tinta-3 text-papel">
        <dt><Icono nombre="reloj" class="size-4 text-ambar" /><span class="sr-only">Horario</span></dt>
        <dd>Lun. a vie. 8:00–18:00 · Sáb. 8:00–13:00</dd>
      </div>
      <div class="chip bg-tinta-3 text-papel">
        <dt><Icono nombre="telefono" class="size-4 text-ambar" /><span class="sr-only">Teléfono</span></dt>
        <dd><a href={`tel:${negocio.telefono}`} class="hover:underline">{negocio.telefonoVisible}</a></dd>
      </div>
    </dl>
  </div>

  <div class="relative mx-2 mt-12 mb-2 h-[26rem] overflow-hidden rounded-[1.4rem] bg-tinta-2 lg:mx-3 lg:mb-3 lg:h-[32rem] lg:rounded-[1.75rem]" data-reveal style="--d:80ms">
    <!-- Mapa ilustrativo: la demo no muestra una ubicación real -->
    <div class="mapa-demo absolute inset-0" aria-hidden="true">
      <span class="absolute top-1/2 left-1/2 grid size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-ambar text-tinta shadow-flota">
        <Icono nombre="pin" class="size-6" trazo={2} />
      </span>
    </div>
    <span class="chip chip-acento pointer-events-none absolute bottom-4 left-4" aria-hidden="true">
      {negocio.sector} · {negocio.ciudad}
      <span class="chip-icono"><Icono nombre="pin" class="size-3.5" trazo={2} /></span>
    </span>
  </div>
</section>

<style>
  /* Cuadrícula de calles ilustrativa en tono oscuro */
  .mapa-demo {
    background-color: var(--color-tinta-2);
    background-image:
      linear-gradient(115deg, transparent 47%, rgb(255 255 255 / 0.1) 47% 53%, transparent 53%),
      linear-gradient(rgb(255 255 255 / 0.05) 2px, transparent 2px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 2px, transparent 2px);
    background-size: 100% 100%, 64px 64px, 64px 64px;
  }
</style>

---
// Frase grande que se "enciende" palabra por palabra al hacer scroll, con dos fotos en forma de píldora.
import { Picture } from 'astro:assets';
import Icono from './Icono.astro';
import bibliotecas from '../assets/images/closet-led.jpg';
import centro from '../assets/images/centro-tv.jpg';
import { negocio } from '../data/negocio';

const frase = `Llevamos ${negocio.aniosOficio} años trabajando la madera en nuestro propio taller. Medimos, diseñamos, fabricamos e instalamos cada mueble pensado para su espacio.`;
const palabras = frase.split(' ');
---
<section class="contenedor py-20 sm:py-24 lg:py-32" aria-label="Quiénes somos">
  <p class="manifiesto max-w-[22ch] text-[clamp(1.85rem,1.2rem+2.9vw,3.4rem)] leading-[1.12] font-medium tracking-[-0.04em] sm:max-w-[26ch]" data-manifiesto>
    {palabras.map((p) => <span class="palabra">{p} </span>)}
  </p>

  <div class="mt-12 grid items-center gap-10 lg:mt-16 lg:grid-cols-[auto_1fr] lg:gap-16">
    <div class="flex items-center gap-2.5 sm:gap-4" data-reveal>
      <div class="relative w-1/2 sm:w-64">
        <span class="chip chip-acento absolute -top-4 left-2 z-10 min-h-9 sm:left-4">
          ★ {negocio.calificacion} de calificación
          <span class="chip-icono"><Icono nombre="taller" class="size-3.5" trazo={2} /></span>
        </span>
        <Picture
          src={bibliotecas}
          formats={['avif', 'webp']}
          widths={[320, 520]}
          sizes="(min-width: 640px) 16rem, 50vw"
          alt="Vestier de madera clara con repisas iluminadas con LED"
          class="aspect-[3/2] w-full rounded-full object-cover"
        />
      </div>
      <div class="relative w-1/2 sm:w-64">
        <Picture
          src={centro}
          formats={['avif', 'webp']}
          widths={[320, 520]}
          sizes="(min-width: 640px) 16rem, 50vw"
          alt="Muro de televisor con paneles de roble claro"
          class="aspect-[3/2] w-full rounded-full object-cover object-[50%_40%]"
        />
        <span class="absolute right-1 bottom-1 grid size-10 place-items-center rounded-full bg-papel shadow-flota sm:size-11">
          <Icono nombre="escuadra" class="size-5" />
        </span>
        <span class="chip chip-oscuro absolute -bottom-5 left-1/2 min-h-9 -translate-x-1/2 -rotate-[4deg]">
          +{negocio.aniosOficio} años de oficio
        </span>
      </div>
    </div>

    <p class="max-w-sm text-[1rem] leading-relaxed text-gris lg:justify-self-end" data-reveal style="--d:100ms">
      Cuéntenos qué tiene en mente y lo convertimos en un mueble para su casa, oficina o negocio. Pedir la cotización es gratis y se hace aquí mismo, en la web.
    </p>
  </div>
</section>

<style>
  /* Sin JS o con "reducir movimiento" la frase se ve completa */
  :global(.js) .manifiesto[data-activo] .palabra {
    /* Gris con contraste 3:1 (texto grande) aun antes de encenderse */
    color: #8e8e8a;
    transition: color 0.35s ease-out;
  }
  :global(.js) .manifiesto[data-activo] .palabra.on {
    color: var(--color-tinta);
  }
</style>

<script>
  const parrafo = document.querySelector<HTMLElement>('[data-manifiesto]');
  if (parrafo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const palabras = [...parrafo.querySelectorAll<HTMLElement>('.palabra')];
    parrafo.dataset.activo = '';
    let pendiente = false;
    const pintar = () => {
      pendiente = false;
      const r = parrafo.getBoundingClientRect();
      const alto = window.innerHeight;
      // 0 cuando el párrafo entra por abajo, 1 cuando llega al tercio superior
      const avance = Math.min(1, Math.max(0, (alto * 0.88 - r.top) / (alto * 0.55 + r.height * 0.4)));
      const encendidas = Math.round(avance * palabras.length);
      palabras.forEach((p, i) => p.classList.toggle('on', i < encendidas));
    };
    const pedir = () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(pintar);
      }
    };
    pintar();
    window.addEventListener('scroll', pedir, { passive: true });
    window.addEventListener('resize', pedir);
  }
</script>

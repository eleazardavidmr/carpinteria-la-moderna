---
import { Picture } from 'astro:assets';
import Icono from './Icono.astro';
import Logo from './Logo.astro';
import foto from '../assets/images/closet-led.jpg';
import detalle from '../assets/images/cocina-cava.jpg';
import { categorias } from '../data/categorias';
import { links, negocio } from '../data/negocio';

const anio = new Date().getFullYear();
const menu = [
  { href: '#servicios', texto: 'Qué hacemos' },
  { href: '#trabajos', texto: 'Trabajos' },
  { href: '#proceso', texto: 'Proceso' },
  { href: '#cotizar', texto: 'Cotizar' },
  { href: '#contacto', texto: 'Contacto' },
];
---
<!-- Cierre: llamado a la acción + cinta con lo que hacemos -->
<section class="overflow-hidden pt-20 sm:pt-24 lg:pt-32" aria-labelledby="cierre-titulo">
  <div class="contenedor grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-end lg:gap-16" data-reveal>
    <h2 id="cierre-titulo" class="titulo-l max-w-[15ch]">Su próximo mueble empieza con un mensaje</h2>
    <div class="lg:justify-self-end">
      <p class="max-w-sm text-[1rem] leading-relaxed text-gris">
        Descríbanos su idea en el formulario, adjunte fotos del lugar y le enviamos la cotización gratis.
      </p>
      <a href="#cotizar" class="btn btn-oscuro mt-6">
        <Icono nombre="enviar" class="size-5" trazo={1.8} />
        Solicitar cotización
      </a>
    </div>
  </div>

  <div class="mt-14 flex items-center lg:mt-20" aria-hidden="true">
    <div class="cinta flex w-max">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 items-center">
            {categorias.map((c) => (
              <li class="flex items-center gap-6 pr-6 text-[clamp(2.4rem,1.6rem+3.5vw,4.5rem)] leading-none font-medium tracking-[-0.045em] whitespace-nowrap sm:gap-10 sm:pr-10">
                {c.nombre}
                <span class="size-3 rounded-full bg-ambar sm:size-4" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<footer class="px-2 pt-20 pb-2 lg:px-3 lg:pb-3">
  <div class="overflow-hidden rounded-[1.75rem] bg-niebla lg:rounded-[2.25rem]">
    <div class="relative mx-2 mt-2 aspect-[16/10] overflow-hidden rounded-[1.4rem] sm:aspect-[21/9] lg:mx-3 lg:mt-3 lg:rounded-[1.75rem]">
      <Picture
        src={foto}
        formats={['avif', 'webp']}
        widths={[480, foto.width]}
        sizes="100vw"
        alt="Vestier de madera clara con repisas iluminadas con LED"
        class="h-full w-full object-cover object-[50%_45%]"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
      <span class="chip chip-blanco absolute top-4 left-4" aria-hidden="true">
        <span class="text-ambar">★</span> {negocio.calificacion} · {negocio.resenas} reseñas de clientes
      </span>
    </div>

    <div class="px-4 pt-8 sm:px-8 lg:px-12">
      <div class="flex items-center gap-4">
        <svg class="min-w-0 flex-1 text-[#3d3d3b]" viewBox="0 0 1000 150" role="img" aria-label={negocio.nombre}>
          <text
            x="0"
            y="122"
            textLength="1000"
            lengthAdjust="spacingAndGlyphs"
            fill="currentColor"
            font-family="'Inter Variable', Inter, sans-serif"
            font-weight="500"
            font-size="168"
            letter-spacing="-8">Taller Nogal</text
          >
        </svg>
        <div class="hidden w-40 shrink-0 overflow-hidden rounded-full sm:block lg:w-56">
          <Picture
            src={detalle}
            formats={['avif', 'webp']}
            widths={[240, 400]}
            sizes="14rem"
            alt=""
            class="aspect-[16/10] w-full object-cover object-[20%_75%]"
          />
        </div>
      </div>

      <div class="mt-10 grid gap-10 border-t border-niebla-2 pt-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
        <div>
          <Logo variante="apilado" class="h-auto w-40" />
          <p class="mt-5 max-w-xs text-[0.9rem] leading-relaxed text-gris">
            Ebanistería en {negocio.ciudad}. Diseñamos y fabricamos muebles a medida desde hace {negocio.aniosOficio} años.
          </p>
        </div>

        <div>
          <h2 class="etiqueta">Contacto</h2>
          <ul class="mt-3 space-y-1 text-[0.95rem]">
            <li>
              <a href={`tel:${negocio.telefono}`} class="flex min-h-11 items-center gap-2.5 hover:text-madera-texto">
                <Icono nombre="telefono" class="size-5" />
                {negocio.telefonoVisible}
              </a>
            </li>
            <li>
              <a href={links.comoLlegar} class="flex min-h-11 items-start gap-2.5 py-2.5 hover:text-madera-texto">
                <Icono nombre="pin" class="mt-0.5 size-5 shrink-0" />
                <span>{negocio.direccion}<br /><span class="text-gris">{negocio.sector}, {negocio.ciudad}</span></span>
              </a>
            </li>
          </ul>
        </div>

        <nav aria-label="Pie de página">
          <h2 class="etiqueta">Navegación</h2>
          <ul class="mt-3 grid grid-cols-2 gap-x-4 text-[0.95rem] sm:grid-cols-1">
            {
              menu.map((m) => (
                <li>
                  <a href={m.href} class="flex min-h-11 items-center hover:text-madera-texto">
                    {m.texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <h2 class="etiqueta">Síganos</h2>
          <ul class="mt-4 flex gap-2">
            <li>
              <a href={negocio.instagram} target="_blank" rel="noopener" class="grid size-12 place-items-center rounded-full bg-papel transition-colors hover:bg-ambar" aria-label="Instagram">
                <Icono nombre="instagram" class="size-5" />
              </a>
            </li>
            <li>
              <a href={negocio.facebook} target="_blank" rel="noopener" class="grid size-12 place-items-center rounded-full bg-papel transition-colors hover:bg-ambar" aria-label="Facebook">
                <Icono nombre="facebook" class="size-5" />
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-2 border-t border-niebla-2 pt-6 pb-20 text-[0.8rem] sm:pb-6 text-gris sm:flex-row sm:items-center sm:justify-between">
        <p>© {anio} {negocio.nombre} · {negocio.eslogan}</p>
        <p>
          Sitio web por <a href="https://edmr.dev" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center font-medium text-tinta hover:text-madera-texto sm:min-h-0">EDMR · edmr.dev</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .cinta {
      animation: correr 40s linear infinite;
    }
  }
  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }
</style>
